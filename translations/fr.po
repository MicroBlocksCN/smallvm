#. String in file picker and library dialogs
msgid "New Folder"
msgstr "Nouveau dossier"

#. String in file picker and library dialogs
#. as in "by Jane Doe", the author of this library
msgid "libdata;by"
msgstr "par"

#. String in file picker and library dialogs
#. as in dependencies of this library
msgid "Depends:"
msgstr "Dépend de :"

#. String in file picker and library dialogs
msgid "Tags:"
msgstr "Mots-clés :"

#. String in file picker and library dialogs
msgid "Path, name or URL for library?"
msgstr "Chemin, nom ou URL de la bibliothèque ?"

#. String in file picker and library dialogs
msgid "Invalid URL"
msgstr "URL invalide"

#. String in file picker and library dialogs
msgid "Could not fetch library."
msgstr "Impossible de récupérer la bibliothèque."

#. String in file picker and library dialogs
msgid "Host does not exist or is currently down."
msgstr "L'hôte n'existe pas ou est actuellement indisponible."

#. String in file picker and library dialogs
msgid "File not found in server."
msgstr "Fichier introuvable sur le serveur."

#. String in file picker and library dialogs
msgid "Server expects HTTPS, and MicroBlocks doesn't currently support it."
msgstr ""
"Le serveur attend du HTTPS, et MicroBlocks ne le supporte pas actuellement."

#. String in file picker and library dialogs
msgid "library information"
msgstr "informations sur la bibliothèque"

#. String in file picker and library dialogs
msgid "built-in library"
msgstr "bibliothèque intégrée"

#. String in file picker and library dialogs
msgid "Dependency path, name or URL?"
msgstr "Chemin, nom ou URL de la dépendance ?"

#. String in file picker and library dialogs
msgid "If you are adding a library that's built into MicroBlocks, you can just enter its name."
msgstr ""
"Si vous ajoutez une bibliothèque intégrée à MicroBlocks, vous pouvez "
"simplement entrer son nom."

#. String in file picker and library dialogs
msgid "If your library is in the Libraries folder in your local MicroBlocks project folder, you need to prefix it with a slash (/)."
msgstr ""
"Si votre bibliothèque est dans le dossier Libraries de votre dossier de "
"projet MicroBlocks local, vous devez la préfixer avec une barre oblique (/)."

#. String in file picker and library dialogs
msgid "If the library is hosted online, please input its full URL."
msgstr ""
"Si la bibliothèque est hébergée en ligne, veuillez entrer son URL complète."

#. String in file picker and library dialogs
msgid "Tag name?"
msgstr "Nom du mot-clé ?"

#. String in file picker and library dialogs
msgid "user library"
msgstr "bibliothèque utilisateur"

#. String in file picker and library dialogs
msgid "Add Library"
msgstr "Ajouter une bibliothèque"

#. the %1 tag should be kept intact. Seconds remaining for a process to finish.
msgid "%1 seconds remaining"
msgstr "%1 secondes restantes"

#. Block size button tooltip
msgid "Decrease block size"
msgstr "Diminuer la taille des blocs"

#. Block size button tooltip
msgid "Restore block size to 100%"
msgstr "Rétablir la taille des blocs à 100%"

#. Block size button tooltip
msgid "Increase block size"
msgstr "Augmenter la taille des blocs"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Button"
msgstr "Bouton"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Boolean Input"
msgstr "Entrée booléenne"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] toggle value, or drop a reporter into it."
msgstr "[l] basculer la valeur, ou y déposer un rapporteur."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Color Input"
msgstr "Entrée de couleur"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] change the color, or drop a reporter into it."
msgstr "[l] changer la couleur, ou y déposer un rapporteur."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Input"
msgstr "Entrée"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] edit its value, or drop a reporter into it."
msgstr "[l] modifier sa valeur, ou y déposer un rapporteur."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Block Extension"
msgstr "Extension de bloc"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] right arrow to show optional inputs, left arrow to hide."
msgstr ""
"[l] flèche droite pour afficher les entrées optionnelles, flèche gauche pour "
"les masquer."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Command Block"
msgstr "Bloc de commande"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Hat Block"
msgstr "Bloc de démarrage"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to run, or drag to build scripts. [r] menu."
msgstr ""
"[l] pour exécuter, ou faire glisser pour construire des scripts. [r] menu."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Reporter Block"
msgstr "Bloc rapporteur"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to see value, or drop into an input slot. [r] menu."
msgstr ""
"[l] pour voir la valeur, ou déposer dans un emplacement d'entrée. [r] menu."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Script"
msgstr "Script"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to run. [r] menu."
msgstr "[l] pour exécuter. [r] menu."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Pane Divider"
msgstr "Séparateur de volet"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Drag to change pane width."
msgstr "Faire glisser pour modifier la largeur du volet."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Library"
msgstr "Bibliothèque"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to show the blocks in this library. [r] menu."
msgstr "[l] pour afficher les blocs de cette bibliothèque. [r] menu."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Block Category"
msgstr "Catégorie de bloc"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] to show the blocks in this category."
msgstr "[l] pour afficher les blocs de cette catégorie."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Palette"
msgstr "Palette"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Drag blocks from here to build scripts. Drop scripts here to delete them."
msgstr ""
"Faites glisser des blocs d'ici pour construire des scripts. Déposez des "
"scripts ici pour les supprimer."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Scripts Pane"
msgstr "Volet des scripts"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "Drag blocks here to build scripts. [r] menu."
msgstr "Faites glisser des blocs ici pour construire des scripts. [r] menu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Turn the user LED on or off."
msgstr "Allume ou éteint la LED utilisateur."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Display a bubble showing the value."
msgstr "Affiche une bulle montrant la valeur."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Graph the value."
msgstr "Trace le graphique de la valeur."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the state of button A ( (-o) or (o-) )."
msgstr "Rapporte l'état du bouton A ( (-o) ou (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the state of button B ( (-o) or (o-) )."
msgstr "Rapporte l'état du bouton B ( (-o) ou (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the milliseconds since the timer was last reset."
msgstr ""
"Rapporte les millisecondes depuis la dernière réinitialisation du minuteur."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Reset the timer."
msgstr "Réinitialise le minuteur."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the seconds since power up."
msgstr "Rapporte les secondes depuis la mise sous tension."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the milliseconds since power up."
msgstr "Rapporte les millisecondes depuis la mise sous tension."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the microseconds since power up."
msgstr "Rapporte les microsecondes depuis la mise sous tension."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the board type."
msgstr "Rapporte le type de carte."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Reports firmware version loaded on the board."
msgstr "Rapporte la version du firmware chargé sur la carte."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Reports the three-letter BLE ID of the board if it supports BLE."
msgstr ""
"Rapporte l'ID BLE à trois lettres de la carte si elle prend en charge le BLE."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Reports (-o) if a BLE client is connected."
msgstr "Rapporte (-o) si un client BLE est connecté."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the milliseconds since the given start milliseconds. Handles clock wrap."
msgstr ""
"Rapporte les millisecondes depuis les millisecondes de départ données. Gère "
"le bouclage de l'horloge."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the microseconds since the given start microseconds. Handles clock wrap."
msgstr ""
"Rapporte les microsecondes depuis les microsecondes de départ données. Gère "
"le bouclage de l'horloge."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Reports (-o) if the board is connected to IDE."
msgstr "Rapporte (-o) si la carte est connectée à l'IDE."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the electrical logic level on a digital pin ( (-o) or (o-) )."
msgstr ""
"Rapporte le niveau logique électrique sur une broche numérique ( (-o) ou "
"(o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a number proportional to the voltage on an analog pin (0 = ground, 1023 = supply voltage)."
msgstr ""
"Rapporte un nombre proportionnel à la tension sur une broche analogique (0 = "
"masse, 1023 = tension d'alimentation)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Turn a pin on or off ( (-o) or (o-) )."
msgstr "Active ou désactive une broche ( (-o) ou (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Pulse width modulate (PWM) a pin with the given duty cycle (0 - 1023)."
msgstr ""
"Modulation de largeur d'impulsion (PWM) d'une broche avec le cycle de "
"service donné (0 - 1023)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report number of analog pins on this device."
msgstr "Rapporte le nombre de broches analogiques sur cet appareil."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report number of digital pins on this device."
msgstr "Rapporte le nombre de broches numériques sur cet appareil."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the value of a register (0-255) of an I2C device (0-127)."
msgstr "Rapporte la valeur d'un registre (0-255) d'un appareil I2C (0-127)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Set an I2C device and register to given value (0-255)."
msgstr "Définit un appareil I2C et un registre à la valeur donnée (0-255)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Receive multiple bytes from an I2C device."
msgstr "Reçoit plusieurs octets d'un appareil I2C."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send multiple bytes to an I2C device."
msgstr "Envoie plusieurs octets à un appareil I2C."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte (0-255) to an SPI device."
msgstr "Envoie un octet (0-255) à un appareil SPI."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Read a byte from an SPI device while sending a zero byte. Report the byte received."
msgstr ""
"Lit un octet d'un appareil SPI tout en envoyant un octet zéro. Rapporte "
"l'octet reçu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Set the SPI clock speed, mode, channel (Raspberry Pi only), and bit order."
msgstr ""
"Définit la vitesse d'horloge SPI, le mode, le canal (Raspberry Pi "
"uniquement) et l'ordre des bits."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte array via SPI, replacing its contents with the bytes received."
msgstr ""
"Envoie un tableau d'octets via SPI, en remplaçant son contenu par les octets "
"reçus."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Open the serial port at the given baud rate."
msgstr "Ouvre le port série au débit en bauds donné."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Close the serial port."
msgstr "Ferme le port série."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report data received from the serial port (a byte array)."
msgstr "Rapporte les données reçues du port série (un tableau d'octets)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte array to the serial port."
msgstr "Envoie un tableau d'octets au port série."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte array to the serial port, starting at the given byte."
msgstr ""
"Envoie un tableau d'octets au port série, en commençant à l'octet donné."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Write a byte to the pin at the specified baud rate."
msgstr "Écrit un octet sur la broche au débit en bauds spécifié."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Run when the board powers up or when the IDE start button is clicked."
msgstr ""
"S'exécute lorsque la carte s'allume ou que le bouton de démarrage de l'IDE "
"est cliqué."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Run when buttons A, B, or A+B are pressed."
msgstr "S'exécute lorsque les boutons A, B ou A+B sont pressés."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Repeat the enclosed blocks indefinitely."
msgstr "Répète les blocs inclus indéfiniment."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Repeat the enclosed blocks the given number of times."
msgstr "Répète les blocs inclus le nombre de fois donné."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Wait the given number of milliseconds."
msgstr "Attend le nombre de millisecondes donné."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Run the first set of blocks whose test condition is (-o) ."
msgstr ""
"Exécute le premier ensemble de blocs dont la condition de test est (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Run when the condition becomes (-o) ."
msgstr "S'exécute lorsque la condition devient (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Wait until the condition becomes (-o) ."
msgstr "Attend jusqu'à ce que la condition devienne (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Return (report) the given value from a function or script."
msgstr "Renvoie (rapporte) la valeur donnée depuis une fonction ou un script."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Run when the given message is received as a broadcast."
msgstr ""
"S'exécute lorsque le message donné est reçu en tant que diffusion (broadcast)"
"."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Broadcast the given message."
msgstr "Diffuse le message donné à tous."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Do nothing. Used to add notes and documentation."
msgstr "Ne fait rien. Utilisé pour ajouter des notes et de la documentation."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a list containing the given range of numbers (with optional increment). Useful in \"for\" loops."
msgstr ""
"Rapporte une liste contenant la plage de nombres donnée (avec un incrément "
"optionnel). Utile dans les boucles \"pour\" (for)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Repeat the enclosed blocks with the variable set to the current iteration number or item."
msgstr ""
"Répète les blocs inclus avec la variable définie sur le numéro de "
"l'itération ou l'élément actuel."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Repeat the enclosed blocks until the condition becomes (-o) ."
msgstr "Répète les blocs inclus jusqu'à ce que la condition devienne (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Stop this task."
msgstr "Arrête cette tâche."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Stop all tasks except this one."
msgstr "Arrête toutes les tâches sauf celle-ci."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Wait the given number of microseconds."
msgstr "Attend le nombre de microsecondes donné."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the last broadcast message received."
msgstr "Rapporte le dernier message diffusé reçu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the given argument or defaultValue if the argument was not supplied by the caller."
msgstr ""
"Rapporte l'argument donné ou defaultValue (valeur par défaut) si l'argument "
"n'a pas été fourni par l'appelant."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Call the function with the given name and optional parameter list."
msgstr ""
"Appelle la fonction avec le nom donné et la liste de paramètres optionnelle."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Call the function with the given name and optional parameter list and report its return value."
msgstr ""
"Appelle la fonction avec le nom donné et la liste de paramètres optionnelle "
"et rapporte sa valeur de retour."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the sum of the given numbers."
msgstr "Rapporte la somme des nombres donnés."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the first number minus the second."
msgstr "Rapporte le premier nombre moins le second."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the product of the given numbers."
msgstr "Rapporte le produit des nombres donnés."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the first number divided by the second."
msgstr "Rapporte le premier nombre divisé par le second."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the remainder of dividing the first number by the second."
msgstr "Rapporte le reste de la division du premier nombre par le second."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the absolute value of the given number (always >= 0)."
msgstr "Rapporte la valeur absolue du nombre donné (toujours >= 0)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the minimum of the values."
msgstr "Rapporte le minimum des valeurs."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the maximum of the values."
msgstr "Rapporte le maximum des valeurs."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a randomly chosen number in the given range."
msgstr "Rapporte un nombre choisi aléatoirement dans la plage donnée."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is less than the second one."
msgstr "Rapporte (-o) si la première valeur est inférieure à la seconde."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is less than or equal to the second one."
msgstr ""
"Rapporte (-o) si la première valeur est inférieure ou égale à la seconde."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the two values are equal."
msgstr "Rapporte (-o) si les deux valeurs sont égales."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the two values are not equal."
msgstr "Rapporte (-o) si les deux valeurs ne sont pas égales."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is greater than or equal to the second one."
msgstr ""
"Rapporte (-o) si la première valeur est supérieure ou égale à la seconde."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is greater than the second one."
msgstr "Rapporte (-o) si la première valeur est supérieure à la seconde."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Boolean constant ( (-o) or (o-) )."
msgstr "Constante booléenne ( (-o) ou (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the logical inverse of a Boolean ( (-o) or (o-) ) value."
msgstr "Rapporte l'inverse logique d'une valeur booléenne ( (-o) ou (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if both values are (-o)"
msgstr "Rapporte (-o) si les deux valeurs sont (-o)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if either value is (-o)"
msgstr "Rapporte (-o) si au moins une des valeurs est (-o)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if first input is a value of the given data type."
msgstr ""
"Rapporte (-o) si la première entrée est une valeur du type de données donné."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Convert a value to the given data type."
msgstr "Convertit une valeur vers le type de données donné."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "If the condition is (-o) report the first alternative otherwise report the second alternative."
msgstr ""
"Si la condition est (-o) rapporte la première alternative, sinon rapporte la "
"seconde alternative."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Map a value in the \"from\" range to the corresponding value in the \"to\" range."
msgstr ""
"Fait correspondre une valeur de la plage \"depuis\" (from) à la valeur "
"correspondante dans la plage \"vers\" (to)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the numerical value of a hexadecimal string (range: -0x1FFFFFFF to 0x1FFFFFFF)"
msgstr ""
"Rapporte la valeur numérique d'une chaîne hexadécimale (plage : -0x1FFFFFFF "
"à 0x1FFFFFFF)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise AND of two numbers."
msgstr "Rapporte le ET (AND) bit à bit de deux nombres."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise OR of two numbers."
msgstr "Rapporte le OU (OR) bit à bit de deux nombres."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise XOR (exclusive OR) of two numbers."
msgstr "Rapporte le XOR (OU exclusif) bit à bit de deux nombres."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise inverse of the given number."
msgstr "Rapporte l'inverse bit à bit du nombre donné."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the given number shifted left by the given number of bits."
msgstr ""
"Rapporte le nombre donné décalé vers la gauche par le nombre de bits donné."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the given number shifted right by the given number of bits (arithmetic shift; sign is maintained)."
msgstr ""
"Rapporte le nombre donné décalé vers la droite par le nombre de bits donné "
"(décalage arithmétique ; le signe est conservé)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Set a variable to the given value."
msgstr "Définit une variable à la valeur donnée."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Change a variable by the given amount."
msgstr "Modifie une variable de la quantité donnée."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Create a variable local to the containing script with the given initial value."
msgstr ""
"Crée une variable locale au script conteneur avec la valeur initiale donnée."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the Nth item of a list, string, or byte array."
msgstr ""
"Rapporte le N-ième élément d'une liste, d'une chaîne ou d'un tableau "
"d'octets."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the number of items in a list, string, or byte array."
msgstr ""
"Rapporte le nombre d'éléments dans une liste, une chaîne ou un tableau "
"d'octets."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Join (concatenate) the given lists, strings, or byte arrays and report the result."
msgstr ""
"Joint (concatène) les listes, chaînes ou tableaux d'octets donnés et "
"rapporte le résultat."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Create and report a short list containing the given items. Length limited by available stack space."
msgstr ""
"Crée et rapporte une petite liste contenant les éléments donnés. La longueur "
"est limitée par l'espace disponible sur la pile."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Add an item to the end of a list."
msgstr "Ajoute un élément à la fin d'une liste."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Replace the Nth item (or all items) of a list or byte array with the given value."
msgstr ""
"Remplace le N-ième élément (ou tous les éléments) d'une liste ou d'un "
"tableau d'octets par la valeur donnée."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Delete the Nth item (or all items) of a list."
msgstr "Supprime le N-ième élément (ou tous les éléments) d'une liste."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Find and report the index of an item in a list or a substring within a string. Report -1 if not found."
msgstr ""
"Trouve et rapporte l'index d'un élément dans une liste ou d'une sous-chaîne "
"dans une chaîne. Rapporte -1 s'il n'est pas trouvé."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a copy from the given index through the end (or optional stop index) of the given list, string, or byte array."
msgstr ""
"Rapporte une copie depuis l'index donné jusqu'à la fin (ou jusqu'à l'index "
"d'arrêt optionnel) de la liste, chaîne ou tableau d'octets."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Split the given string with the given delimiter and report the result (a list of strings)."
msgstr ""
"Découpe la chaîne donnée avec le séparateur donné et rapporte le résultat "
"(une liste de chaînes)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Combine the items of a list into a string, optionally separated by a delimiter (e.g. comma)."
msgstr ""
"Combine les éléments d'une liste en une chaîne, facultativement séparés par "
"un délimiteur (ex. une virgule)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the Unicode value (\"code point\") of the Nth character of the given string."
msgstr ""
"Rapporte la valeur Unicode (\"point de code\") du N-ième caractère de la "
"chaîne donnée."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a string containing the given Unicode value (\"code point\") or list of values."
msgstr ""
"Rapporte une chaîne contenant la valeur Unicode (\"point de code\") donnée "
"ou une liste de valeurs."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a new list of the given length filled with zero or the optional value."
msgstr ""
"Rapporte une nouvelle liste de la longueur donnée, remplie de zéros ou de la "
"valeur optionnelle."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a new byte array of the given length filled with zero or the optional value."
msgstr ""
"Rapporte un nouveau tableau d'octets de la longueur donnée, rempli de zéros "
"ou de la valeur optionnelle."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a byte array containing the UTF-8 bytes of the given string."
msgstr ""
"Rapporte un tableau d'octets contenant les octets UTF-8 de la chaîne donnée."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the number of words of memory available. Stop button frees up memory."
msgstr ""
"Rapporte le nombre de mots de mémoire disponibles. Le bouton Arrêter libère "
"de la mémoire."

