#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to run. [r] menu."
msgstr "[l] untuk jalankan. [r] menu."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Pane Divider"
msgstr "Pemisah Panel"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Drag to change pane width."
msgstr "Seret untuk ubah lebar panel."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Library"
msgstr "Pustaka"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to show the blocks in this library. [r] menu."
msgstr "[l] untuk tampilkan blok di pustaka ini. [r] menu."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Block Category"
msgstr "Kategori Blok"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] to show the blocks in this category."
msgstr "[l] untuk tampilkan blok dalam kategori ini."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Palette"
msgstr "Palet"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Drag blocks from here to build scripts. Drop scripts here to delete them."
msgstr ""
"Seret blok dari sini untuk bangun skrip. Jatuhkan skrip di sini untuk "
"menghapusnya."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Scripts Pane"
msgstr "Panel Skrip"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "Drag blocks here to build scripts. [r] menu."
msgstr "Seret blok ke sini untuk bangun skrip. [r] menu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Turn the user LED on or off."
msgstr "Nyalakan atau matikan LED pengguna."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Display a bubble showing the value."
msgstr "Tampilkan gelembung yang memperlihatkan nilainya."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Graph the value."
msgstr "Grafikkan nilainya."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the state of button A ( (-o) or (o-) )."
msgstr "Laporkan status tombol A ( (-o) atau (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the state of button B ( (-o) or (o-) )."
msgstr "Laporkan status tombol B ( (-o) atau (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the milliseconds since the timer was last reset."
msgstr "Laporkan milidetik sejak penghitung waktu terakhir direset."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Reset the timer."
msgstr "Reset penghitung waktu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the seconds since power up."
msgstr "Laporkan detik sejak dinyalakan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the milliseconds since power up."
msgstr "Laporkan milidetik sejak dinyalakan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the microseconds since power up."
msgstr "Laporkan mikrodetik sejak dinyalakan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the board type."
msgstr "Laporkan jenis papan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Reports firmware version loaded on the board."
msgstr "Melaporkan versi firmware yang dimuat di papan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Reports the three-letter BLE ID of the board if it supports BLE."
msgstr "Melaporkan ID BLE tiga huruf dari papan jika mendukung BLE."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Reports (-o) if a BLE client is connected."
msgstr "Melaporkan (-o) jika klien BLE terhubung."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the milliseconds since the given start milliseconds. Handles clock wrap."
msgstr ""
"Laporkan milidetik sejak milidetik mulai yang diberikan. Menangani putaran "
"jam."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the microseconds since the given start microseconds. Handles clock wrap."
msgstr ""
"Laporkan mikrodetik sejak mikrodetik mulai yang diberikan. Menangani putaran "
"jam."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Reports (-o) if the board is connected to IDE."
msgstr "Melaporkan (-o) jika papan terhubung ke IDE."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the electrical logic level on a digital pin ( (-o) or (o-) )."
msgstr "Laporkan tingkat logika listrik pada pin digital ( (-o) atau (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a number proportional to the voltage on an analog pin (0 = ground, 1023 = supply voltage)."
msgstr ""
"Laporkan angka yang proporsional dengan tegangan pada pin analog (0 = "
"ground, 1023 = tegangan suplai)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Turn a pin on or off ( (-o) or (o-) )."
msgstr "Nyalakan atau matikan pin ( (-o) atau (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Pulse width modulate (PWM) a pin with the given duty cycle (0 - 1023)."
msgstr ""
"Modulasi lebar pulsa (PWM) pin dengan siklus kerja yang diberikan (0 - 1023)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report number of analog pins on this device."
msgstr "Laporkan jumlah pin analog pada perangkat ini."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report number of digital pins on this device."
msgstr "Laporkan jumlah pin digital pada perangkat ini."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the value of a register (0-255) of an I2C device (0-127)."
msgstr "Laporkan nilai register (0-255) dari perangkat I2C (0-127)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Set an I2C device and register to given value (0-255)."
msgstr "Atur perangkat I2C dan register ke nilai yang diberikan (0-255)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Receive multiple bytes from an I2C device."
msgstr "Terima beberapa byte dari perangkat I2C."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send multiple bytes to an I2C device."
msgstr "Kirim beberapa byte ke perangkat I2C."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte (0-255) to an SPI device."
msgstr "Kirim byte (0-255) ke perangkat SPI."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Read a byte from an SPI device while sending a zero byte. Report the byte received."
msgstr ""
"Baca byte dari perangkat SPI saat mengirim byte nol. Laporkan byte yang "
"diterima."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Set the SPI clock speed, mode, channel (Raspberry Pi only), and bit order."
msgstr ""
"Atur kecepatan jam SPI, mode, saluran (hanya Raspberry Pi), dan urutan bit."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte array via SPI, replacing its contents with the bytes received."
msgstr ""
"Kirim array byte melalui SPI, mengganti isinya dengan byte yang diterima."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Open the serial port at the given baud rate."
msgstr "Buka port serial pada baud rate yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Close the serial port."
msgstr "Tutup port serial."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report data received from the serial port (a byte array)."
msgstr "Laporkan data yang diterima dari port serial (array byte)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte array to the serial port."
msgstr "Kirim array byte ke port serial."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte array to the serial port, starting at the given byte."
msgstr "Kirim array byte ke port serial, mulai dari byte yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Write a byte to the pin at the specified baud rate."
msgstr "Tulis byte ke pin pada baud rate yang ditentukan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Run when the board powers up or when the IDE start button is clicked."
msgstr "Jalankan saat papan dinyalakan atau saat tombol mulai IDE diklik."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Run when buttons A, B, or A+B are pressed."
msgstr "Jalankan saat tombol A, B, atau A+B ditekan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Repeat the enclosed blocks indefinitely."
msgstr "Ulangi blok yang tertutup tanpa batas."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Repeat the enclosed blocks the given number of times."
msgstr "Ulangi blok yang tertutup sejumlah kali yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Wait the given number of milliseconds."
msgstr "Tunggu sejumlah milidetik yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Run the first set of blocks whose test condition is (-o) ."
msgstr "Jalankan set blok pertama yang kondisi ujinya (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Run when the condition becomes (-o) ."
msgstr "Jalankan saat kondisi menjadi (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Wait until the condition becomes (-o) ."
msgstr "Tunggu sampai kondisi menjadi (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Return (report) the given value from a function or script."
msgstr "Kembalikan (laporkan) nilai yang diberikan dari fungsi atau skrip."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Run when the given message is received as a broadcast."
msgstr "Jalankan saat pesan yang diberikan diterima sebagai siaran."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Broadcast the given message."
msgstr "Siarkan pesan yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Do nothing. Used to add notes and documentation."
msgstr ""
"Tidak melakukan apa-apa. Digunakan untuk menambah catatan dan dokumentasi."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a list containing the given range of numbers (with optional increment). Useful in \"for\" loops."
msgstr ""
"Laporkan daftar yang berisi rentang angka yang diberikan (dengan penambahan "
"opsional). Berguna dalam loop \"for\"."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Repeat the enclosed blocks with the variable set to the current iteration number or item."
msgstr ""
"Ulangi blok yang tertutup dengan variabel diatur ke nomor iterasi atau item "
"saat ini."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Repeat the enclosed blocks until the condition becomes (-o) ."
msgstr "Ulangi blok yang tertutup sampai kondisi menjadi (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Stop this task."
msgstr "Hentikan tugas ini."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Stop all tasks except this one."
msgstr "Hentikan semua tugas kecuali yang ini."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Wait the given number of microseconds."
msgstr "Tunggu sejumlah mikrodetik yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the last broadcast message received."
msgstr "Laporkan pesan siaran terakhir yang diterima."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the given argument or defaultValue if the argument was not supplied by the caller."
msgstr ""
"Laporkan argumen yang diberikan atau nilaiDefault jika argumen tidak "
"diberikan oleh pemanggil."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Call the function with the given name and optional parameter list."
msgstr ""
"Panggil fungsi dengan nama yang diberikan dan daftar parameter opsional."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Call the function with the given name and optional parameter list and report its return value."
msgstr ""
"Panggil fungsi dengan nama yang diberikan dan daftar parameter opsional dan "
"laporkan nilai kembaliannya."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the sum of the given numbers."
msgstr "Laporkan jumlah dari angka-angka yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the first number minus the second."
msgstr "Laporkan angka pertama dikurangi angka kedua."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the product of the given numbers."
msgstr "Laporkan hasil perkalian dari angka-angka yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the first number divided by the second."
msgstr "Laporkan angka pertama dibagi angka kedua."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the remainder of dividing the first number by the second."
msgstr "Laporkan sisa pembagian angka pertama dengan angka kedua."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the absolute value of the given number (always >= 0)."
msgstr "Laporkan nilai absolut dari angka yang diberikan (selalu >= 0)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the minimum of the values."
msgstr "Laporkan nilai minimum."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the maximum of the values."
msgstr "Laporkan nilai maksimum."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a randomly chosen number in the given range."
msgstr "Laporkan angka yang dipilih secara acak dalam rentang yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is less than the second one."
msgstr "Laporkan (-o) jika nilai pertama kurang dari yang kedua."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is less than or equal to the second one."
msgstr ""
"Laporkan (-o) jika nilai pertama kurang dari atau sama dengan yang kedua."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the two values are equal."
msgstr "Laporkan (-o) jika kedua nilai sama."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the two values are not equal."
msgstr "Laporkan (-o) jika kedua nilai tidak sama."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is greater than or equal to the second one."
msgstr ""
"Laporkan (-o) jika nilai pertama lebih besar dari atau sama dengan yang "
"kedua."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is greater than the second one."
msgstr "Laporkan (-o) jika nilai pertama lebih besar dari yang kedua."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Boolean constant ( (-o) or (o-) )."
msgstr "Konstanta boolean ( (-o) atau (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the logical inverse of a Boolean ( (-o) or (o-) ) value."
msgstr "Laporkan invers logika dari nilai Boolean ( (-o) atau (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if both values are (-o)"
msgstr "Laporkan (-o) jika kedua nilai adalah (-o)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if either value is (-o)"
msgstr "Laporkan (-o) jika salah satu nilai adalah (-o)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if first input is a value of the given data type."
msgstr ""
"Laporkan (-o) jika input pertama adalah nilai dari tipe data yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Convert a value to the given data type."
msgstr "Konversi nilai ke tipe data yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "If the condition is (-o) report the first alternative otherwise report the second alternative."
msgstr ""
"Jika kondisi (-o) laporkan alternatif pertama, jika tidak laporkan "
"alternatif kedua."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Map a value in the \"from\" range to the corresponding value in the \"to\" range."
msgstr ""
"Petakan nilai dalam rentang \"dari\" ke nilai yang sesuai dalam rentang "
"\"ke\"."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the numerical value of a hexadecimal string (range: -0x1FFFFFFF to 0x1FFFFFFF)"
msgstr ""
"Laporkan nilai numerik dari string heksadesimal (rentang: -0x1FFFFFFF hingga "
"0x1FFFFFFF)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise AND of two numbers."
msgstr "Laporkan bitwise AND dari dua angka."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise OR of two numbers."
msgstr "Laporkan bitwise OR dari dua angka."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise XOR (exclusive OR) of two numbers."
msgstr "Laporkan bitwise XOR (exclusive OR) dari dua angka."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise inverse of the given number."
msgstr "Laporkan invers bitwise dari angka yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the given number shifted left by the given number of bits."
msgstr ""
"Laporkan angka yang diberikan digeser ke kiri sejumlah bit yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the given number shifted right by the given number of bits (arithmetic shift; sign is maintained)."
msgstr ""
"Laporkan angka yang diberikan digeser ke kanan sejumlah bit yang diberikan "
"(geseran aritmatika; tanda dipertahankan)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Set a variable to the given value."
msgstr "Atur variabel ke nilai yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Change a variable by the given amount."
msgstr "Ubah variabel sebesar jumlah yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Create a variable local to the containing script with the given initial value."
msgstr ""
"Buat variabel lokal untuk skrip yang memuatnya dengan nilai awal yang "
"diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the Nth item of a list, string, or byte array."
msgstr "Laporkan item ke-N dari daftar, string, atau array byte."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the number of items in a list, string, or byte array."
msgstr "Laporkan jumlah item dalam daftar, string, atau array byte."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Join (concatenate) the given lists, strings, or byte arrays and report the result."
msgstr ""
"Gabungkan (concatenate) daftar, string, atau array byte yang diberikan dan "
"laporkan hasilnya."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Create and report a short list containing the given items. Length limited by available stack space."
msgstr ""
"Buat dan laporkan daftar pendek yang berisi item yang diberikan. Panjang "
"dibatasi oleh ruang tumpukan yang tersedia."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Add an item to the end of a list."
msgstr "Tambahkan item ke akhir daftar."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Replace the Nth item (or all items) of a list or byte array with the given value."
msgstr ""
"Ganti item ke-N (atau semua item) dari daftar atau array byte dengan nilai "
"yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Delete the Nth item (or all items) of a list."
msgstr "Hapus item ke-N (atau semua item) dari daftar."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Find and report the index of an item in a list or a substring within a string. Report -1 if not found."
msgstr ""
"Cari dan laporkan indeks item dalam daftar atau substring dalam string. "
"Laporkan -1 jika tidak ditemukan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a copy from the given index through the end (or optional stop index) of the given list, string, or byte array."
msgstr ""
"Laporkan salinan dari indeks yang diberikan hingga akhir (atau indeks "
"berhenti opsional) dari daftar, string, atau array byte yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Split the given string with the given delimiter and report the result (a list of strings)."
msgstr ""
"Pisahkan string yang diberikan dengan pembatas yang diberikan dan laporkan "
"hasilnya (daftar string)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Combine the items of a list into a string, optionally separated by a delimiter (e.g. comma)."
msgstr ""
"Gabungkan item daftar menjadi string, secara opsional dipisahkan oleh "
"pembatas (misalnya koma)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the Unicode value (\"code point\") of the Nth character of the given string."
msgstr ""
"Laporkan nilai Unicode (\"titik kode\") dari karakter ke-N dari string yang "
"diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a string containing the given Unicode value (\"code point\") or list of values."
msgstr ""
"Laporkan string yang berisi nilai Unicode (\"titik kode\") yang diberikan "
"atau daftar nilai."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a new list of the given length filled with zero or the optional value."
msgstr ""
"Laporkan daftar baru dengan panjang yang diberikan diisi dengan nol atau "
"nilai opsional."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a new byte array of the given length filled with zero or the optional value."
msgstr ""
"Laporkan array byte baru dengan panjang yang diberikan diisi dengan nol atau "
"nilai opsional."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a byte array containing the UTF-8 bytes of the given string."
msgstr "Laporkan array byte yang berisi byte UTF-8 dari string yang diberikan."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the number of words of memory available. Stop button frees up memory."
msgstr ""
"Laporkan jumlah kata (words) memori yang tersedia. Tombol stop membebaskan "
"memori."

#. Block in Function Calls library
msgid "function _ exists"
msgstr "fungsi _ ada"

#. External Displays Library block
#. The #BR# tag must be kept intact. It translates to a new line
msgid "attach ST7735 w _ h _ rotation _ #BR# dc pin _ cs pin _ backlight pin _"
msgstr ""
"sambungkan ST7735 lebar _ tinggi _ rotasi _ #BR# pin dc _ pin cs _ pin "
"cahaya latar _"

#. TFT Display library block
msgid "draw image _ on TFT at x _ y _ color _"
msgstr "gambar citra _ pada TFT di x _ y _ warna _"

#. Example string. Tells the user this input accepts a list of strings.
msgid "a list of strings"
msgstr "daftar string"

