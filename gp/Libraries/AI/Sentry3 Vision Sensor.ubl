module 'Sentry3 Vision Sensor' Control
author '作者 AITosee'
version 1 0
depends 'Other/Sentry Communication Protocol'
choices sentry3VisionMenu ' Color ' ' Blob ' ' AprilTag ' ' Line ' ' Learning ' ' Face ' ' Objects ' ' QrCode ' ' BarCode ' ' OCR ' ' HandPose ' ' LicensePlate ' 
choices sentry3VisionValueMenu ' Blob ' ' AprilTag ' ' Learning ' ' Face ' ' Objects ' ' HandPose '
choices sentry3OperaVisionMenu ' Learning ' ' Face ' 
choices sentry3VisionParamNumMenu ' Color ' ' Blob ' 
choices sentry3VisionStringMenu ' QrCode ' ' BarCode ' ' OCR ' ' LicensePlate ' 
choices sentry3ObjInfoMenu 'x-coord' 'y-coord' width height label 
choices sentry3ObjInfoQrMenu 'x-coord' 'y-coord' width height 
choices sentry3ObjectsClassMenu '1  person' '2  bicycle' '3  car' '4  motorcycle' '5  airplane' '6  bus' '7  train' '8  truck' '9  boat' '10 traffic light' '11 fire hydrant' '12 stop sign' '13 parking meter' '14 bench' '15 bird' '16 cat' '17 dog' '18 horse' '19 sheep' '20 cow' '21 elephant' '22 bear' '23 zebra' '24 giraffe' '25 backpack' '26 umbrella' '27 handbag' '28 tie' '29 suitcase' '30 frisbee' '31 skis' '32 snowboard' '33 sports ball' '34 kite' '35 baseball bat' '36 baseball glove' '37 skateboard' '38 surfboard' '39 tennis racket' '40 bottle' '41 wine glass' '42 cup' '43 fork' '44 knife' '45 spoon' '46 bowl' '47 banana' '48 apple' '49 sandwich' '50 orange' '51 broccoli' '52 carrot' '53 hot dog' '54 pizza' '55 donut' '56 cake' '57 chair' '58 couch' '59 potted plant' '60 bed' '61 dining table' '62 toilet' '63 tv' '64 laptop' '65 mouse' '66 remote' '67 keyboard' '68 cell phone' '69 microwave' '70 oven' '71 toaster' '72 sink' '73 refrigerator' '74 book' '75 clock' '76 vase' '77 scissors' '78 teddy bear' '79 hair drier' '80 toothbrush' 
choices sentry3ObjInfoColorMenu label 'red CH value' 'green CH value' 'blue CH value' 
choices sentry3ColorMenu Black White Red Green Blue Yellow 
choices sentry3VisionStaMenu run stop 
choices sentry3IndexMenu '#1' '#2' '#3' '#4' '#5' 
choices sentry3HandPoseFingerStateMenu bent extended ignore 
choices sentry3HandPosePresetMenu One Two Three Four Five Six Eight Ten Yeah Rock Scissors Paper Like OK 
choices sentry3ObjInfoLineMenu 'x-coord of ending point' 'y-coord of ending point' 'x-coord of starting point' 'y-coord of starting point' 'inclination angle' 
choices sentry3CommModeMenu I2C Serial 
choices sentry3OperaParamMenu 'learn and assign' 'delete data' 
choices sentry3AddrMenu '0x60' '0x61' '0x62' '0x63' 
choices sentry3LedColorMenu Black Red Green Yellow Blue Purple Cyan White 
description 'Sentry3 vision sensor library with I2C/UART support
Supports color detection, blob detection, AprilTag, line detection, learning mode, qr，ocr, face detection, and Objects object detection
'
variables _sentry3_vision_list 

  spec ' ' 'Sentry3 Begin' 'Initialize  Sentry3 _  port _ addr _' 'menu.sentry3IndexMenu menu.sentry3CommModeMenu menu.sentry3AddrMenu' '#1' 'I2C' '0x60'
  spec ' ' 'Sentry3 LedSetColor' 'Set  Sentry3 _  light color _ upon targets detection otherwise _ brightness(1-10) _' 'menu.sentry3IndexMenu menu.sentry3LedColorMenu menu.sentry3LedColorMenu num' '#1' 'Blue' 'Red' 1
  spec ' ' 'Sentry3 VisionSetStatus' 'Set  Sentry3 _  _  algo _' 'menu.sentry3IndexMenu menu.sentry3VisionStaMenu menu.sentry3VisionMenu' '#1' 'run' ' Color '
  spec ' ' 'Sentry3 VisionSetParamNum' 'Set  Sentry3 _  algo _  _ sets of params' 'menu.sentry3IndexMenu menu.sentry3VisionParamNumMenu num' '#1' ' Color ' 1
  spec ' ' 'Sentry3 VisionColorSetParam' 'Set  Sentry3 _  algo Color  x-coord _ y-coord _ width _ height _ paramset _' 'menu.sentry3IndexMenu num num num num num' '#1' 50 50 3 4 1
  spec ' ' 'Sentry3 VisionBlobSetParam' 'Set  Sentry3 _  algo Blob  min-width _ min-height _ color _ paramset _' 'menu.sentry3IndexMenu num num menu.sentry3ColorMenu num' '#1' 3 4 'Red' 1
  spec ' ' 'Sentry3 VisionSetParam' 'Set  Sentry3 _  algo _  _  ID _' 'menu.sentry3IndexMenu menu.sentry3OperaVisionMenu menu.sentry3OperaParamMenu num' '#1' ' Learning ' 'learn and assign' 1
  spec 'r' 'Sentry3 VisionDetectedCount' 'Sentry3 _  algo _  num of results' 'menu.sentry3IndexMenu menu.sentry3VisionMenu' '#1' ' Color '
  spec 'r' 'Sentry3 GetVisionObjColorValue' 'Sentry3 _  algo Color  _ of result _' 'menu.sentry3IndexMenu menu.sentry3ObjInfoColorMenu num' '#1' 'label' 1
  spec 'r' 'Sentry3 GetVisionObjValue' 'Sentry3 _  algo _  _ of result _' 'menu.sentry3IndexMenu menu.sentry3VisionValueMenu menu.sentry3ObjInfoMenu num' '#1' ' Blob ' 'x-coord' 1
  spec 'r' 'Sentry3 GetVisionObjLineValue' 'Sentry3 _  algo Line   _ of result _' 'menu.sentry3IndexMenu menu.sentry3ObjInfoLineMenu num' '#1' 'x-coord of ending point' 1
  spec 'r' 'Sentry3 GetVisionObjStringValue' 'Sentry3 _  algo _  _ of result _' 'menu.sentry3IndexMenu menu.sentry3VisionStringMenu menu.sentry3ObjInfoQrMenu num' '#1' ' QrCode ' 'x-coord' 1
  spec 'r' 'Sentry3 GetString' 'Sentry3 _  algo _  string of decoding result _' 'menu.sentry3IndexMenu menu.sentry3VisionStringMenu num' '#1' ' QrCode ' 1
  spec 'r' 'Sentry3 VisionDetectedColor' 'Sentry3 _  algo Color  recognized _ result _' 'menu.sentry3IndexMenu menu.sentry3ColorMenu num' '#1' 'Black' 1
  spec 'r' 'Sentry3 VisionDetectedBlob' 'Sentry3 _  algo Blob  detected _ blob result _' 'menu.sentry3IndexMenu menu.sentry3ColorMenu num' '#1' 'Red' 1
  spec 'r' 'Sentry3 VisionDetectedObjects' 'Sentry3 _  algo Objects  recognized _ result _' 'menu.sentry3IndexMenu menu.sentry3ObjectsClassMenu num' '#1' '1  person' 1
  spec 'r' 'Sentry3 VisionDetectedHandPoseCustom' 'Sentry3 _  algo HandPose  detected thumb _ index _ middle _ ring _ pinky _ result _' 'menu.sentry3IndexMenu menu.sentry3HandPoseFingerStateMenu menu.sentry3HandPoseFingerStateMenu menu.sentry3HandPoseFingerStateMenu menu.sentry3HandPoseFingerStateMenu menu.sentry3HandPoseFingerStateMenu num' '#1' 'extended' 'extended' 'extended' 'extended' 'extended' 1
  spec 'r' 'Sentry3 VisionDetectedHandPosePreset' 'Sentry3 _  algo HandPose  recognized gesture _ result _' 'menu.sentry3IndexMenu menu.sentry3HandPosePresetMenu num' '#1' 'One' 1

to 'Sentry3 Begin' index_menu comm_mode address {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  _sentry3_vision_list = ('[data:makeList]' ' Color ' ' Blob ' ' AprilTag ' ' Line ' ' Learning ' 'n' ' Face ' ' Objects ' ' QrCode ' ' BarCode ' 'n' ' OCR ' ' HandPose ' ' LicensePlate ')

    if ('[vars:varExists]' '_sentry_comm_config_list') {
      '_sentry comm initialize' idx (hexToInt address) comm_mode
    } else {
      sayIt 'Please import "Sentry Communication Protocol"'
      waitMillis 500
      stopTask
    }
  return
}

to 'Sentry3 GetString' index_menu vision_type obj_id {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  local 'byteArrayData' 0
  byteArrayData = ('_sentry comm read string' idx ('_sentry3 get vision id' vision_type) obj_id)
  return ('_sentry utf8 decode' byteArrayData)
}

to 'Sentry3 GetVisionObjColorValue' index_menu obj_info obj_id {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  return ('_sentry comm get value' idx 1 obj_info obj_id)
}

to 'Sentry3 GetVisionObjLineValue' index_menu obj_info obj_id {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  return ('_sentry comm get value' idx 4 obj_info obj_id)
}

to 'Sentry3 GetVisionObjStringValue' index_menu vision_type obj_info obj_id {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  return ('_sentry comm get value' idx ('_sentry3 get vision id' vision_type) obj_info obj_id)
}

to 'Sentry3 GetVisionObjValue' index_menu vision_type obj_info obj_id {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  return ('_sentry comm get value' idx ('_sentry3 get vision id' vision_type) obj_info obj_id)
}

to 'Sentry3 LedSetColor' index_menu detected_color undetected_color level {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  return ('_sentry comm led set color' idx detected_color undetected_color level)
}

to 'Sentry3 VisionBlobSetParam' index_menu min_width min_height color_label param_num {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  local 'colorId' ('_sentry comm get color index' color_label)
  if (0 == colorId) {
    colorId = 1
  }
  local 'params' ('[data:newByteArray]' 10 0)
  atPut 5 params ((min_width >> 8) & 255)
  atPut 6 params (min_width & 255)
  atPut 7 params ((min_height >> 8) & 255)
  atPut 8 params (min_height & 255)
  atPut 9 params ((colorId >> 8) & 255)
  atPut 10 params (colorId & 255)
  return ('_sentry comm set param' idx 2 param_num params)
}

to 'Sentry3 VisionColorSetParam' index_menu x_value y_value width height param_num {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  local 'params' ('[data:newByteArray]' 10 0)
  atPut 1 params ((x_value >> 8) & 255)
  atPut 2 params (x_value & 255)
  atPut 3 params ((y_value >> 8) & 255)
  atPut 4 params (y_value & 255)
  atPut 5 params ((width >> 8) & 255)
  atPut 6 params (width & 255)
  atPut 7 params ((height >> 8) & 255)
  atPut 8 params (height & 255)
  return ('_sentry comm set param' idx 1 param_num params)
}

to 'Sentry3 VisionDetectedBlob' index_menu color_label obj_id {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  return (('_sentry comm get value' idx 2 'label' obj_id) == ('_sentry comm get color index' color_label))
}

to 'Sentry3 VisionDetectedColor' index_menu color_label obj_id {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  return (('_sentry comm get value' idx 1 'label' obj_id) == ('_sentry comm get color index' color_label))
}

to 'Sentry3 VisionDetectedCount' index_menu vision_type {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  return ('_sentry comm vision detected count' idx ('_sentry3 get vision id' vision_type))
}

to 'Sentry3 VisionDetectedHandPoseCustom' index_menu thumb_state index_state middle_state ring_state pinky_state obj_id {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  local 'label' ('_sentry comm get value' idx 13 'label' obj_id)
  local 'mask' 0
  local 'status' 0
  if (thumb_state != 'ignore') {
    mask = (mask | 1)
    if (thumb_state == 'extended') {
      status = (status | 1)
    }
  }
  if (index_state != 'ignore') {
    mask = (mask | 2)
    if (index_state == 'extended') {
      status = (status | 2)
    }
  }
  if (middle_state != 'ignore') {
    mask = (mask | 4)
    if (middle_state == 'extended') {
      status = (status | 4)
    }
  }
  if (ring_state != 'ignore') {
    mask = (mask | 8)
    if (ring_state == 'extended') {
      status = (status | 8)
    }
  }
  if (pinky_state != 'ignore') {
    mask = (mask | 16)
    if (pinky_state == 'extended') {
      status = (status | 16)
    }
  }
  return ((label & mask) == status)
}

to 'Sentry3 VisionDetectedHandPosePreset' index_menu handpose_preset obj_id {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  local 'label' ('_sentry comm get value' idx 13 'label' obj_id)
  return ((label & 31) == ('_sentry3_get_handpose_preset_value' handpose_preset))
}

to 'Sentry3 VisionDetectedObjects' index_menu Objects_class obj_id {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  local 'spacePos' ('[data:find]' ' ' Objects_class)
  if (spacePos == 0) {
    return 0
  }
  return (('_sentry comm get value' idx 8 'label' obj_id) == (('[data:convertType]' ('[data:copyFromTo]' Objects_class 1 (spacePos - 1)) 'number')))
}

to 'Sentry3 VisionSetParam' index_menu vision_type opera_param param_num {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  local 'lastParam' (ifExpression (opera_param == 'learn and assign') 100 0)
  local 'params' ('[data:newByteArray]' 10 0)
  atPut 9 params ((lastParam >> 8) & 255)
  atPut 10 params (lastParam & 255)
  return ('_sentry comm set param' idx ('_sentry3 get vision id' vision_type) param_num params)
}

to 'Sentry3 VisionSetParamNum' index_menu vision_type max_num {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  '_sentry comm vision set param num' idx ('_sentry3 get vision id' vision_type) max_num
  return 0
}

to 'Sentry3 VisionSetStatus' index_menu vision_sta vision_type {
  local 'idx' ('_sentry3 get index from menu' index_menu)
  return ('_sentry comm vision set status' idx vision_sta ('_sentry3 get vision id' vision_type))
}


to '_sentry3 get index from menu' index_menu {

  if (isType index_menu 'string') {
    if ((at 1 index_menu) == '#') {
      local 'index' ('[data:convertType]' (at 2 index_menu) 'number')
      return (((index & 7) << 5) | 8)
    }
  }
  
  return 8
}

to '_sentry3 get vision id' vision_type {
  local 'id' ('[data:find]' vision_type _sentry3_vision_list)
  if (id > 0) {
    return id
  }
  for i (size _sentry3_vision_list) {
    if (('[data:find]' vision_type (at i _sentry3_vision_list)) > 0) {return i}
  }
  sayIt vision_type  id 'Error: not found!'
  waitMicros 2000
  stopTask
  return 0
}

to '_sentry3_get_handpose_preset_value' handpose_preset {
  comment 'Return preset value directly based on preset name'
  if (handpose_preset == 'One') {
    return 2
  } (or (handpose_preset == 'Two') (handpose_preset == 'Yeah')) {
    return 6
  } (or (handpose_preset == 'Three') (handpose_preset == 'OK')) {
    return 28
  } (handpose_preset == 'Four') {
    return 30
  } (handpose_preset == 'Five') {
    return 31
  } (handpose_preset == 'Six') {
    return 17
  } (handpose_preset == 'Eight') {
    return 3
  } (or (handpose_preset == 'Ten') (handpose_preset == 'Rock')) {
    return 0
  } (handpose_preset == 'Scissors') {
    return 6
  } (handpose_preset == 'Paper') {
    return 31
  } (handpose_preset == 'Like') {
    return 1
  }
  return -1
}
