module 'Sentry Communication Protocol' Control
author 'AiToose'
version 1 0
depends 'Other/Sentry Serial Protocol' 
description '底层通信协议库，支持Sentry2和Sentry3的I2C通信
设备配置使用20位整数存储：bit15=通信模式,bit8-14=地址,bit0-7=deviceIdx(0-4位设备ID,5-7位索引) 
支持多个设备同时使用，通过index和设备ID组合区分
'
variables _sentry_comm_config_list _sentry_comm_cache_validation

to '_sentry comm unpack address' config {
  // comment 'Extract address from device config (bits 8-14)'
  return ((config >> 8) & 127)
}

to '_sentry comm unpack comm mode' config {
  // comment 'Extract communication mode from device config (bit 15)'
  return ((config & 32768) != 0)
}

to '_sentry comm get device config' deviceIdx {
  // comment 'Get device config by deviceIdx - returns 16-bit packed config'
  // comment 'deviceIdx: bit0-7=deviceId+index'
  // comment 'Lazy init config list when first used'
  if (_sentry_comm_config_list == 0) {
    return 0
  }
  // comment 'Search config by deviceIdx (low 8 bits) using loop traversal'
  for i (size _sentry_comm_config_list) {
    local 'config' (at i _sentry_comm_config_list)
    if (((config & 255) == (deviceIdx & 255))) {
      return config
    }
  }

  return 0
}

to '_sentry comm set device config' deviceIdx address commMode {
  // comment 'Set device config by deviceIdx - 16-bit packed config'
  // comment 'Ensure deviceIdx in bit0-7, address in bit8-14, mode in bit15'
  // comment 'Lazy init config list when first used'
  if (_sentry_comm_config_list == 0) {
    _sentry_comm_config_list = (newList 0)
  }

  local 'config' 0
  config = (config | (deviceIdx & 255))
  config = (config | ((address & 127) << 8))
  if (commMode == 'Serial') {
    config = (config | 32768)
  }

  // comment 'Search config by deviceIdx (low 8 bits) using loop traversal'
  local 'found' false
  for i (size _sentry_comm_config_list) {
    if ((((at i _sentry_comm_config_list) & 255) == (deviceIdx & 255))) {
      atPut i _sentry_comm_config_list config
      found = true
    }
  }
  if (not found) {
    // comment 'Config not found, add new config'
    '[data:addLast]' config _sentry_comm_config_list 
  }

  return config
}

to '_sentry comm i2c get' address reg_address {
  // comment 'I2C Get operation - read value from register'
  local 'value' (i2cGet address reg_address)
  // UdpLog 'reg_r' reg_address value
  if (value < 0) {
    // comment 'SENTRY_I2C_ERROR'
    sayIt 'SENTRY_I2C_ERROR'
    waitMillis 2000
    return 0
  }
  return value
}

to '_sentry comm i2c set' address reg_address value {
  // comment 'I2C Set operation - write value to register'
  i2cSet address reg_address value
  // UdpLog 'reg_w' reg_address value
  // comment 'SENTRY_OK'
  return 0
}

to '_sentry comm i2c set param' address visionId param_id paramsBuffer {
  // comment 'I2C SetParam operation - set vision parameters using provided ByteArray buffer'
  // comment 'Set vision ID register (0x20)'
  '_sentry comm i2c set' address 32 visionId
  // comment 'Set parameter ID register (0x24)'
  '_sentry comm i2c set' address 36 param_id
  // comment 'Read parameter values from provided ByteArray buffer (5 x 16-bit = 10 bytes)'
  // comment '0x70: ParamValue1H'
  '_sentry comm i2c set' address 112 (at 1 paramsBuffer)
  // comment '0x71: ParamValue1L'
  '_sentry comm i2c set' address 113 (at 2 paramsBuffer)
  // comment '0x72: ParamValue2H'
  '_sentry comm i2c set' address 114 (at 3 paramsBuffer)
  // comment '0x73: ParamValue2L'
  '_sentry comm i2c set' address 115 (at 4 paramsBuffer)
  // comment '0x74: ParamValue3H'
  '_sentry comm i2c set' address 116 (at 5 paramsBuffer)
  // comment '0x75: ParamValue3L'
  '_sentry comm i2c set' address 117 (at 6 paramsBuffer)
  // comment '0x76: ParamValue4H'
  '_sentry comm i2c set' address 118 (at 7 paramsBuffer)
  // comment '0x77: ParamValue4L'
  '_sentry comm i2c set' address 119 (at 8 paramsBuffer)
  // comment '0x78: ParamValue5H'
  '_sentry comm i2c set' address 120 (at 9 paramsBuffer)
  // comment '0x79: ParamValue5L'
  '_sentry comm i2c set' address 121 (at 10 paramsBuffer)
  // comment 'SENTRY_OK'
  return 0
}

to '_sentry comm i2c read object' address visionId obj_id cacheEntryIndex {
  // comment 'Read single object data from sensor via I2C and write directly to ByteArray cache in list by index'
  // comment 'Set vision ID register (0x20)'
  '_sentry comm i2c set' address 32 visionId
  // comment 'Set result ID register (0x35)'
  '_sentry comm i2c set' address 53 obj_id
  local 'cacheEntry' (at cacheEntryIndex _sentry_comm_cache_validation)
  if (cacheEntry == 0) {
    return 0
  }
  // comment 'Read 5 data values (each is 16-bit) directly into ByteArray cache'
  local 'regBase' 0
  local 'highByte' 0
  local 'lowByte' 0
  local 'byteOffset' 0
  for i 5 {
    // comment '0x80, 0x82, 0x84, 0x86, 0x88'
    regBase = (128 + ((i - 1) * 2))
    highByte = ('_sentry comm i2c get' address regBase)
    lowByte = ('_sentry comm i2c get' address (regBase + 1))
    // comment 'Write directly to ByteArray: data area starts at position 6'
    byteOffset = (6 + ((i - 1) * 2))
    atPut byteOffset cacheEntry highByte
    atPut (byteOffset + 1) cacheEntry lowByte
  }
  atPut cacheEntryIndex _sentry_comm_cache_validation cacheEntry
}

to '_sentry comm i2c read string' address visionId obj_id {
  // comment 'Read string data from sensor via I2C'
  // comment 'Set vision ID register (0x20)'
  '_sentry comm i2c set' address 32 visionId
  // comment 'Set result ID register (0x35) to select object'
  '_sentry comm i2c set' address 53 obj_id
  // comment 'Read actual byte count from register 0x6A (106) - important for Chinese characters'
  local 'read_len' ('_sentry comm i2c get' address 106)
  if (read_len <= 0) {
    sayIt 'SENTRY_I2C_STRING_EMPTY'
    waitMillis 2000
    return ('[data:newByteArray]' 0 0)
  }
  // comment 'Write read_len to register 0x6e (110)'
  '_sentry comm i2c set' address 110 read_len
  // comment 'Read characters from register 0x6C (108) - loop read_len times'
  local 'strData' ('[data:newByteArray]' read_len 0)
  local 'char' 0
  for i read_len {
    char = ('_sentry comm i2c get' address 108)
    // comment 'Append character byte to data list (read all bytes)'
    if (char > 0) {
      atPut i strData char
    } else {
      sayIt 'SENTRY_I2C_CHAR_READ_FAIL'
      waitMillis 2000
      return ('[data:newByteArray]' 0 0)
    }
  }
  // comment 'Return ByteArray'
  return strData
}

to '_sentry comm get' deviceIdx reg_address {
  // comment 'Unified Get interface - hides I2C/UART protocol differences'
  // comment 'Get device config by index (contains index, deviceId, address, commMode)'
  local 'deviceConfig' ('_sentry comm get device config' deviceIdx)
  local 'address' ('_sentry comm unpack address' deviceConfig)
  local 'isSerial' ('_sentry comm unpack comm mode' deviceConfig)
  if isSerial {
    return ('_sentry comm uart get' address reg_address)
  }
  return ('_sentry comm i2c get' address reg_address)
}

to '_sentry comm set' deviceIdx reg_address value {
  // comment 'Unified Set interface - hides I2C/UART protocol differences'
  // comment 'Get device config by index (contains index, deviceId, address, commMode)'
  local 'deviceConfig' ('_sentry comm get device config' deviceIdx)
  local 'address' ('_sentry comm unpack address' deviceConfig)
  local 'isSerial' ('_sentry comm unpack comm mode' deviceConfig)
  if isSerial {
    return ('_sentry comm uart set' address reg_address value)
  }
  return ('_sentry comm i2c set' address reg_address value)
}

to '_sentry comm set param' deviceIdx visionId param_id paramsBuffer {
  // comment 'Unified SetParam interface - hides I2C/UART protocol differences'
  // comment 'Get device config by index (contains index, deviceId, address, commMode)'
  local 'deviceConfig' ('_sentry comm get device config' deviceIdx)
  local 'address' ('_sentry comm unpack address' deviceConfig)
  local 'isSerial' ('_sentry comm unpack comm mode' deviceConfig)
  if isSerial {
    return ('_sentry comm uart set param' address visionId param_id paramsBuffer)
  }
  return ('_sentry comm i2c set param' address visionId param_id paramsBuffer)
}

to '_sentry comm read object' deviceIdx visionId obj_id cacheEntryIndex {
  // comment 'Unified ReadObject interface - hides I2C/UART protocol differences'
  // comment 'Get device config by index (contains index, deviceId, address, commMode)'
  local 'deviceConfig' ('_sentry comm get device config' deviceIdx)
  local 'address' ('_sentry comm unpack address' deviceConfig)
  local 'isSerial' ('_sentry comm unpack comm mode' deviceConfig)
  if isSerial {
    return ('_sentry comm uart read object' address visionId obj_id cacheEntryIndex)
  }
  return ('_sentry comm i2c read object' address visionId obj_id cacheEntryIndex)
}

to '_sentry comm read string' deviceIdx visionId obj_id {
  // comment 'Unified ReadString interface - hides I2C/UART protocol differences'
  // comment 'Get device config by index (contains index, deviceId, address, commMode)'
  local 'deviceConfig' ('_sentry comm get device config' deviceIdx)
  local 'address' ('_sentry comm unpack address' deviceConfig)
  local 'isSerial' ('_sentry comm unpack comm mode' deviceConfig)
  if isSerial {
    return ('_sentry comm uart read string' address visionId obj_id)
  }
  return ('_sentry comm i2c read string' address visionId obj_id)
}

to '_sentry comm set and verify' deviceIdx reg_address value {
  local 'retryCount' 0
  repeat 5 {
    '_sentry comm set' deviceIdx reg_address value
    local 'readValue' ('_sentry comm get' deviceIdx reg_address)
    if (readValue == value) {
      return 0
    }
    retryCount = (retryCount + 1)
  }

  sayIt 'SENTRY_SET_VERIFY_FAIL'
  waitMillis 2000
  return 17
}

to '_sentry comm get obj info index' property {
  if (isType property 'number') {
    return property
  } (or (property == 'x-coord') (property == 'red CH value') (property == 'x-coord of ending point')) {
    return 1
  } (or (property == 'y-coord') (property == 'green CH value') (property == 'y-coord of ending point')) {
    return 2
  } (or (property == 'width') (property == 'blue CH value') (property == 'x-coord of starting point')) {
    return 3
  } (or (property == 'height') (property == 'y-coord of starting point')) {
    return 4
  } (or (property == 'label') (property == 'inclination angle')) {
    return 5
  }

  return 0
}

to '_sentry comm get word' byteArray offset {
  return (((at offset byteArray) << 8) | (at (offset + 1) byteArray))
}

to '_sentry comm ensure cache list' {
  if (_sentry_comm_cache_validation == 0) {
    _sentry_comm_cache_validation = (newList 0)
  }
}

to '_sentry comm cache get byte' entryIndex offset {
  '_sentry comm ensure cache list'
  local 'cacheEntry' (at entryIndex _sentry_comm_cache_validation)
  if (cacheEntry == 0) {
    return 0
  }
  return (at offset cacheEntry)
}

to '_sentry comm cache get word' entryIndex dataOffset {
  '_sentry comm ensure cache list'
  local 'cacheEntry' (at entryIndex _sentry_comm_cache_validation)
  if (cacheEntry == 0) {
    return 0
  }
  local 'byteOffset' (6 + (dataOffset * 2))
  return (((at byteOffset cacheEntry) << 8) | (at (byteOffset + 1) cacheEntry))
}

to '_sentry comm cache set byte' entryIndex offset value {
  '_sentry comm ensure cache list'
  local 'cacheEntry' (at entryIndex _sentry_comm_cache_validation)
  if (cacheEntry == 0) {
    return 0
  }
  atPut offset cacheEntry value
  atPut entryIndex _sentry_comm_cache_validation cacheEntry
}

to '_sentry comm find cache entry' deviceIdx visionId {
  '_sentry comm ensure cache list'
  local 'listSize' (size _sentry_comm_cache_validation)
  for i listSize {
    local 'cacheEntry' (at i _sentry_comm_cache_validation)
    if (cacheEntry != 0) {
      if (and ((at 1 cacheEntry) == deviceIdx) ((at 2 cacheEntry) == visionId)) {return i}
    }
  }
  return 0
}

to '_sentry comm update cache entry' deviceIdx visionId frame detectCount {
  '_sentry comm ensure cache list'
  local 'entryIndex' ('_sentry comm find cache entry' deviceIdx visionId)
  if (entryIndex > 0) {
    local 'cacheEntry' (at entryIndex _sentry_comm_cache_validation)
    atPut 1 cacheEntry deviceIdx
    atPut 2 cacheEntry visionId
    atPut 3 cacheEntry frame
    atPut 4 cacheEntry detectCount
    atPut 5 cacheEntry 0
    for i 10 {
      atPut (5 + i) cacheEntry 0
    }
    atPut entryIndex _sentry_comm_cache_validation cacheEntry
    return entryIndex
  } else {
    local 'cacheEntry' ('[data:newByteArray]' 15 0)
    atPut 1 cacheEntry deviceIdx
    atPut 2 cacheEntry visionId
    atPut 3 cacheEntry frame
    atPut 4 cacheEntry detectCount
    atPut 5 cacheEntry 0
    '[data:addLast]' cacheEntry _sentry_comm_cache_validation
    return (size _sentry_comm_cache_validation)
  }
}

to '_sentry comm vision set param num' deviceIdx visionId max_num {
  if (visionId == 0) {
    sayIt 'Invalid vision id'
    waitMillis 2000
    return 16
  }
  '_sentry comm set' deviceIdx 32 visionId
  '_sentry comm set' deviceIdx 35 max_num
  return 0
}

to '_sentry comm vision set status' deviceIdx vision_sta visionId {
  if (visionId == 0) {
    sayIt 'Invalid vision id'
    waitMillis 2000
    return 16
  }
  local 'err' ('_sentry comm set and verify' deviceIdx 32 visionId)
  if (err != 0) {return err}
  local 'visionConfig' ('_sentry comm get' deviceIdx 33)
  local 'newStatus' (ifExpression (vision_sta == 'run') 1 0)
  if ((visionConfig & 1) != newStatus) {
    visionConfig = ((visionConfig & 254) | newStatus)
    err = ('_sentry comm set and verify' deviceIdx 33 visionConfig)
    if (err != 0) {return err}
  }
  '_sentry comm ensure cache list'
  local 'entryIndex' ('_sentry comm find cache entry' deviceIdx visionId)
  if (vision_sta == 'run') {
    if (entryIndex == 0) {
      '_sentry comm update cache entry' deviceIdx visionId 0 0
    }
  } else {
    if (entryIndex != 0) {
      '[data:delete]' entryIndex _sentry_comm_cache_validation
    }
  }
  return 0
}

to '_sentry comm vision detected count' deviceIdx visionId {
  if (visionId == 0) {return 0}
  '_sentry comm ensure cache list'
  local 'entryIndex' ('_sentry comm find cache entry' deviceIdx visionId)
  if (entryIndex == 0) {return -1}
  local 'currentFrame' ('_sentry comm get' deviceIdx 31)
  local 'cache_frame' ('_sentry comm cache get byte' entryIndex 3)
  local 'cache_count' ('_sentry comm cache get byte' entryIndex 4)
  local 'detectCount' 0
  local 'tryCount' 0
  repeatUntil (detectCount != 0) {
    if (or (cache_frame == 0) (cache_count == 0) (cache_frame == currentFrame)) {
      '_sentry comm sensor lock' deviceIdx false
      cache_frame = currentFrame
      repeatUntil (currentFrame != cache_frame) {
        waitMillis 10
        currentFrame = ('_sentry comm get' deviceIdx 31)
      }
      cache_frame = currentFrame
    }
    '_sentry comm set' deviceIdx 32 visionId
    detectCount = ('_sentry comm get' deviceIdx 52)
    if (detectCount == 0) {
      tryCount = (tryCount + 1)
      if (3 < tryCount) {
        '_sentry comm update cache entry' deviceIdx visionId currentFrame detectCount
        return 0
      }
    } else {
      '_sentry comm sensor lock' deviceIdx true
    }
  }
  '_sentry comm update cache entry' deviceIdx visionId currentFrame detectCount
  return detectCount
}

to '_sentry comm get value' deviceIdx visionId property obj_id {
  if (or (visionId == 0) (obj_id < 1)) {
    sayIt 'Invalid vision id'
    return 0
  }

  local 'propertyId' ('_sentry comm get obj info index' property)
  if (or (propertyId < 1) (propertyId > 5)) {
    sayIt 'Invalid property name'
    return 0
  }

  local 'entryIndex' ('_sentry comm find cache entry' deviceIdx visionId)
  if (entryIndex == 0) {
    sayIt 'Please open vision first'
    return 0
  }

  local 'cachedDetectCount' ('_sentry comm cache get byte' entryIndex 4)
  if (or (cachedDetectCount == 0) (obj_id > cachedDetectCount)) {
    sayIt 'Please call detected count first'
    return 0
  }

  local 'cacheObjId' ('_sentry comm cache get byte' entryIndex 5)
  if (or (cacheObjId == 0) (cacheObjId != obj_id)) {
    '_sentry comm cache set byte' entryIndex 5 obj_id
    '_sentry comm set' deviceIdx 32 visionId
    '_sentry comm read object' deviceIdx visionId obj_id entryIndex
  }

  return ('_sentry comm cache get word' entryIndex (propertyId - 1))
}

to '_sentry comm led set color' deviceIdx detected_color undetected_color level {
  local 'led_colors_list' ('[data:makeList]' 'Black' 'Red' 'Green' 'Yellow' 'Blue' 'Purple' 'Cyan' 'White')
  local 'detectedIdx' ('[data:find]' detected_color led_colors_list)
  local 'undetectedIdx' ('[data:find]' undetected_color led_colors_list)
  if (or (detectedIdx == 0) (undetectedIdx == 0)) {
    sayIt 'Invalid led color'
    waitMillis 2000
    return 16
  }
  local 'ledLevel' ('_sentry comm get' deviceIdx 8)
  ledLevel = ((ledLevel & 240) | (level & 15))
  '_sentry comm set' deviceIdx 8 ledLevel
  local 'ledValue' ('_sentry comm get' deviceIdx 6)
  ledValue = (ledValue & 16)
  if (detected_color == undetected_color) {ledValue = (ledValue | 1)}
  ledValue = ((ledValue | ((detectedIdx - 1) << 1)) | ((undetectedIdx - 1) << 5))
  '_sentry comm set' deviceIdx 6 ledValue
  return 0
}
to '_sentry comm sensor init' deviceIdx {
  // comment 'Initialize sensor hardware'
  // comment 'Get expected device ID from config'
  local 'deviceConfig' ('_sentry comm get device config' deviceIdx)
  local 'expectedDeviceId' (deviceConfig & 31)
  // comment 'Check sensor startup - wait for bit 0 of register 0x04 to be 1'
  local 'startupCount' 0
  repeatUntil (1 == (('_sentry comm get' deviceIdx 4) & 1)) {
    startupCount = (startupCount + 1)
    if (startupCount > 20) {
      sayIt 'SENTRY_UNKNOWN_PROTOCOL'
      waitMillis 2000
      return 17
    }
    // comment 'Wait 100ms'
    waitMillis 100
  }
  // comment 'Check protocol version - read device ID from register 0x01'
  local 'versionCount' 0
  local 'deviceId' 0
  repeatUntil (deviceId == expectedDeviceId) {
    versionCount = (versionCount + 1)
    deviceId = ('_sentry comm get' deviceIdx 1)
    if (versionCount > 10) {
      sayIt 'sentry device ID mismatch'
      waitMillis 2000
      return 17
    }
  }
  // comment 'Set sensor default - set bit 3 of register 0x04'
  local 'sensorConfig' ('_sentry comm get' deviceIdx 4)
  sensorConfig = (sensorConfig | 8)
  '_sentry comm set' deviceIdx 4 sensorConfig
  // comment 'Wait for default setting to complete - wait until bit 3 is cleared'
  repeatUntil (8 != (('_sentry comm get' deviceIdx 4) & 8)) {
    // comment 'Wait for completion'
  }
  // comment 'SENTRY_OK'
  return 0
}

to '_sentry comm sensor lock' deviceIdx lock {
  // comment 'Lock or unlock sensor register (0x05)'
  local 'lockValue' (ifExpression lock 1 0)
  '_sentry comm set' deviceIdx 5 lockValue
  repeatUntil (lockValue == (('_sentry comm get' deviceIdx 5) & 1)) {
    '_sentry comm set' deviceIdx 5 lockValue
    // comment 'Wait for completion'
  }
  return 0
}

to '_sentry comm sensor set default' deviceIdx {
  // comment 'Restore sensor to default settings'
  // comment 'Read SensorConfig1 register (0x04)'
  local 'sensorConfig' ('_sentry comm get' deviceIdx 4)
  // comment 'Set bit 3 to trigger default restoration'
  sensorConfig = (sensorConfig | 8)
  '_sentry comm set' deviceIdx 4 sensorConfig
  // comment 'Wait for bit 3 to clear (indicating completion)'
  repeatUntil (0 == (('_sentry comm get' deviceIdx 4) & 8)) {
    waitMillis 50
  }
  return 0
}

to '_sentry utf8 decode' byteArray {
  local 'len' (size byteArray)
  if (len <= 0) {
    return ''
  }
  local 'unicodeList' (newList 0)
  local 'i' 1
  local 'b' 0
  local 'bytes' 0
  local 'mask' 0
  local 'cp' 0
  local 'j' 0
  local 'nextByte' 0
  repeatUntil (i > len) {
    b = (at i byteArray)
    if ((b & 128) == 0) {
      '[data:addLast]' b unicodeList
      i = (i + 1)
    } else {
      if ((b & 224) == 192) {
        bytes = 2
        mask = 31
      } else {
        if ((b & 240) == 224) {
          bytes = 3
          mask = 15
        } else {
          if ((b & 248) == 240) {
            bytes = 4
            mask = 7
          } else {
            i = (i + 1)
          }
        }
      }
      if (bytes > 0) {
        if (((i + bytes) - 1) > len) {
          i = (i + 1)
        } else {
          cp = (b & mask)
          j = 1
          repeatUntil (j >= bytes) {
            nextByte = (at (i + j) byteArray)
            if ((nextByte & 192) != 128) {
              break
            }
            cp = ((cp << 6) | (nextByte & 63))
            j = (j + 1)
          }
          if (j == bytes) {
            '[data:addLast]' cp unicodeList
            i = (i + bytes)
          } else {
            i = (i + 1)
          }
          bytes = 0
        }
      }
    }
  }
  return ('[data:unicodeString]' unicodeList)
}

to '_sentry comm get color index' color_label {
  if (color_label == 'Black') {
    return 1
  } (color_label == 'White') {
    return 2
  } (color_label == 'Red') {
    return 3
  } (color_label == 'Green') {
    return 4
  } (color_label == 'Blue') {
    return 5
  } (color_label == 'Yellow') {
    return 6
  }
  return 0
}

to '_sentry comm initialize' deviceIdx address commMode {
  // comment 'Initialize device base configuration'
  // comment 'Parameters: deviceIdx(index+deviceId), address (I2C/UART address), commMode (Serial or I2C)'

  // comment 'Check address validity'
  if (address == 0) {
    sayIt 'SENTRY_INVALID_ADDRESS'
    waitMillis 2000
    return 1
  }

  if (commMode == 'Serial') {
    if ('[vars:varExists]' '_sentry_comm_buffer_size') {
      '_sentry comm uart clear buffer'
    } else {
      sayIt 'Please import "Sentry Serial Protocol"'
      waitMillis 500
      stopTask
    }
  } else {
    // comment 'I2C mode - check if device exists'
    if (not ('[sensors:i2cExists]' address)) {
      sayIt 'Can not find i2c device！！！'
      waitMillis 200
      return 16
    }
  }

  // comment 'Pack and store device config'
  ('_sentry comm set device config' deviceIdx address commMode)
  // comment 'Initialize sensor'
  local 'err' ('_sentry comm sensor init' deviceIdx)
  if (0 != err) {
    return err
  }
  err = ('_sentry comm sensor set default' deviceIdx)
  if (err == 0) {
    return 0
  }
  sayIt 'SENTRY_SENSOR_DEFAULT_FAIL'
  waitMillis 2000
  return err
}
