module 'Sentry Serial Protocol' Control
author 'AITosee'
version 1 2
description '底层通信协议库，支持Sentry2和Sentry3的串口通信
'
variables _sentry_comm_uart_packet_buffer _sentry_comm_uart_response_buffer _sentry_comm_buffer_size 


to '_sentry comm uart clear buffer' {
  '[serial:read]'
  _sentry_comm_buffer_size = 0
  if (_sentry_comm_uart_packet_buffer == 0) {
    _sentry_comm_uart_packet_buffer = ('[data:newByteArray]' 32 0)
  }
  if (_sentry_comm_uart_response_buffer == 0) {
    _sentry_comm_uart_response_buffer = ('[data:newByteArray]' 128 0)
    _sentry_comm_uart_buffer_size = 0
  }
}

to '_sentry comm uart get' address reg_address {
  if (_sentry_comm_uart_packet_buffer == 0) {_sentry_comm_uart_packet_buffer = ('[data:newByteArray]' 32 0)}
  atPut 3 _sentry_comm_uart_packet_buffer address
  atPut 4 _sentry_comm_uart_packet_buffer 2
  atPut 5 _sentry_comm_uart_packet_buffer reg_address
  '_sentry comm uart send packet' 1
  local 'responseLength' ('_sentry comm uart read response')
  if (responseLength < 3) {
    // comment  sayIt 'SENTRY_UART_READ_TIMEOUT'
    waitMillis 2000
    return 0
  }
  if ((at 1 _sentry_comm_uart_response_buffer) == 224) {
    if (responseLength >= 3) {return (at 3 _sentry_comm_uart_response_buffer)}
  }
  // comment  sayIt 'SENTRY_UART_GET_FAIL'
  waitMillis 2000
  return 0
}

to '_sentry comm uart read object' address visionId obj_id cacheEntryIndex {
  if (_sentry_comm_uart_packet_buffer == 0) {_sentry_comm_uart_packet_buffer = ('[data:newByteArray]' 32 0)}
  atPut 3 _sentry_comm_uart_packet_buffer address
  atPut 4 _sentry_comm_uart_packet_buffer 35
  atPut 5 _sentry_comm_uart_packet_buffer visionId
  atPut 6 _sentry_comm_uart_packet_buffer obj_id
  atPut 7 _sentry_comm_uart_packet_buffer obj_id
  '_sentry comm uart send packet' 3
  local 'responseLength' ('_sentry comm uart read response')
  local 'cacheEntry' (at cacheEntryIndex _sentry_comm_cache_validation)
  if (cacheEntry == 0) {
    return 0
  }
  if (responseLength < 6) {
    // comment  sayIt 'SENTRY_UART_NO_DATA'
    waitMillis 2000
    local 'byteOffset' 0
    for i 5 {
      byteOffset = (6 + ((i - 1) * 2))
      atPut byteOffset cacheEntry 0
      atPut (byteOffset + 1) cacheEntry 0
    }
    atPut cacheEntryIndex _sentry_comm_cache_validation cacheEntry
    return 0
  }
  local 'highByte' 0
  local 'lowByte' 0
  local 'byteOffset' 0
  if (responseLength > 15) {
    for i 5 {
      highByte = (at (5 + (i * 2)) _sentry_comm_uart_response_buffer)
      lowByte = (at (6 + (i * 2)) _sentry_comm_uart_response_buffer)
      byteOffset = (6 + ((i - 1) * 2))
      atPut byteOffset cacheEntry highByte
      atPut (byteOffset + 1) cacheEntry lowByte
    }
  } else {
    // comment  sayIt 'SENTRY_UART_DATA_SHORT'
    waitMillis 2000
    for i 5 {
      byteOffset = (6 + ((i - 1) * 2))
      atPut byteOffset cacheEntry 0
      atPut (byteOffset + 1) cacheEntry 0
    }
  }
  atPut cacheEntryIndex _sentry_comm_cache_validation cacheEntry
}

to '_sentry comm uart read response' {
  if (_sentry_comm_uart_response_buffer == 0) {
    _sentry_comm_uart_response_buffer = ('[data:newByteArray]' 128 0)
    _sentry_comm_buffer_size = 0
  }
  local 'timeoutCount' 0
  local 'datalen' 0
  local 'ckdatalen' 0
  local 'checksum' 0
  local 'responseLength' 0
  local 'newData' 0
  local 'newDataSize' 0
  repeatUntil (timeoutCount > 10) {
    newData = ('[serial:read]')
    newDataSize = (size newData)
    if (newDataSize > 0) {
      for i newDataSize {
        if (_sentry_comm_buffer_size < 128) {
          atPut (_sentry_comm_buffer_size + 1) _sentry_comm_uart_response_buffer (at i newData)
          _sentry_comm_buffer_size = (_sentry_comm_buffer_size + 1)
        }
      }
      if ((at 1 _sentry_comm_uart_response_buffer) == 255) {
        if (_sentry_comm_buffer_size >= 2) {
          datalen = (at 2 _sentry_comm_uart_response_buffer)
          ckdatalen = (datalen - 2)
          if (_sentry_comm_buffer_size >= datalen) {
            checksum = 0
            for i ckdatalen {
              checksum = (checksum + (at i _sentry_comm_uart_response_buffer))
            }
            if ((at (datalen - 1) _sentry_comm_uart_response_buffer) == (checksum & 255)) {
              responseLength = (datalen - 5)
              if (responseLength > 0) {
                for i responseLength {
                  atPut i _sentry_comm_uart_response_buffer (at (3 + i) _sentry_comm_uart_response_buffer)
                }
                local 'remainingSize' (_sentry_comm_buffer_size - datalen)
                if (remainingSize > 0) {
                  for i remainingSize {
                    atPut i _sentry_comm_uart_response_buffer (at (datalen + i) _sentry_comm_uart_response_buffer)
                  }
                }
                _sentry_comm_buffer_size = (_sentry_comm_buffer_size - datalen)
                return responseLength
              }
            } else {
              for i (_sentry_comm_buffer_size - 1) {
                atPut i _sentry_comm_uart_response_buffer (at (i + 2) _sentry_comm_uart_response_buffer)
              }
              _sentry_comm_buffer_size = (_sentry_comm_buffer_size - 1)
            }
          } else {
          }
        }
      } else {
        for i (_sentry_comm_buffer_size - 1) {
          atPut i _sentry_comm_uart_response_buffer (at (i + 2) _sentry_comm_uart_response_buffer)
        }
        _sentry_comm_buffer_size = (_sentry_comm_buffer_size - 1)
      }
    } else {
      waitMillis 200
    }
    timeoutCount = (timeoutCount + 1)
  }
  // comment  sayIt 'SENTRY_UART_RESPONSE_TIMEOUT'
  waitMillis 2000
  return 0
}

to '_sentry comm uart read string' address visionId obj_id {
  if (_sentry_comm_uart_packet_buffer == 0) {_sentry_comm_uart_packet_buffer = ('[data:newByteArray]' 32 0)}
  atPut 3 _sentry_comm_uart_packet_buffer address
  atPut 4 _sentry_comm_uart_packet_buffer 39
  atPut 5 _sentry_comm_uart_packet_buffer visionId
  atPut 6 _sentry_comm_uart_packet_buffer obj_id
  atPut 7 _sentry_comm_uart_packet_buffer 0
  atPut 8 _sentry_comm_uart_packet_buffer 0
  '_sentry comm uart send packet' 4
  local 'tryTime' 0
  local 'strListTemp' ('[data:newByteArray]' 0 0)
  local 'responseLength' 0
  local 'startCharIdx' 0
  local 'stopCharIdx' 0
  local 'strLen' 0
  local 'strList' 0
  local 'actualDataLen' 0
  repeatUntil (tryTime > 10) {
    responseLength = ('_sentry comm uart read response')
    if (responseLength < 7) {
      tryTime = (tryTime + 1)
      waitMillis 100
    } else {
      if (not (or ((at 1 _sentry_comm_uart_response_buffer) == 224) ((at 1 _sentry_comm_uart_response_buffer) == 236))) {
        tryTime = (tryTime + 1)
        waitMillis 100
      } else {
        if ((at 2 _sentry_comm_uart_response_buffer) != 39) {
          tryTime = (tryTime + 1)
          waitMillis 100
        } else {
          if (not (and ((at 4 _sentry_comm_uart_response_buffer) == visionId) ((at 5 _sentry_comm_uart_response_buffer) == obj_id))) {
            tryTime = (tryTime + 1)
            waitMillis 100
          } else {
            startCharIdx = (at 6 _sentry_comm_uart_response_buffer)
            stopCharIdx = (at 7 _sentry_comm_uart_response_buffer)
            strLen = ((stopCharIdx - startCharIdx) + 1)
            strList = ('[data:newByteArray]' strLen 0)
            actualDataLen = (responseLength - 7)
            if (strLen != actualDataLen) {
              // comment  sayIt 'SENTRY_STRING_LENGTH_MISMATCH'
              waitMillis 2000
              return ('[data:newByteArray]' 0 0)
            }
            for i actualDataLen {
              atPut i strList (at (7 + i) _sentry_comm_uart_response_buffer)
            }
            strListTemp = ('[data:join]' strListTemp strList)
            if ((at 1 _sentry_comm_uart_response_buffer) == 224) {
              return strListTemp
            }
            tryTime = 0
          }
        }
      }
    }
  }
  // comment  sayIt 'SENTRY_UART_STRING_TIMEOUT'
  waitMillis 2000
  return ('[data:newByteArray]' 0 0)
}

to '_sentry comm uart send packet' dataLength {
  if (_sentry_comm_uart_packet_buffer == 0) {_sentry_comm_uart_packet_buffer = ('[data:newByteArray]' 32 0)}
  local 'totalLength' (6 + dataLength)
  atPut 1 _sentry_comm_uart_packet_buffer 255
  atPut 2 _sentry_comm_uart_packet_buffer totalLength
  local 'checksum' 0
  local 'checkEnd' (4 + dataLength)
  for i checkEnd {
    checksum = (checksum + (at i _sentry_comm_uart_packet_buffer))
  }
  atPut (checkEnd + 1) _sentry_comm_uart_packet_buffer (checksum & 255)
  atPut (checkEnd + 2) _sentry_comm_uart_packet_buffer 237
  '_sentry comm uart clear buffer'
  for i totalLength {
    '[serial:write]' (at i _sentry_comm_uart_packet_buffer)
  }
}

to '_sentry comm uart set' address reg_address value {
  if (_sentry_comm_uart_packet_buffer == 0) {_sentry_comm_uart_packet_buffer = ('[data:newByteArray]' 32 0)}
  atPut 3 _sentry_comm_uart_packet_buffer address
  atPut 4 _sentry_comm_uart_packet_buffer 1
  atPut 5 _sentry_comm_uart_packet_buffer reg_address
  atPut 6 _sentry_comm_uart_packet_buffer value
  '_sentry comm uart send packet' 2
  local 'responseLength' ('_sentry comm uart read response')
  if (responseLength < 3) {
    // comment  sayIt 'SENTRY_WRITE_TIMEOUT'
    waitMillis 2000
    return 2
  }
  if ((at 1 _sentry_comm_uart_response_buffer) == 224) {
    return 0
  }
  // comment  sayIt 'SENTRY_FAIL'
  waitMillis 2000
  return 1
}

to '_sentry comm uart set param' address visionId param_id paramsBuffer {
  if (_sentry_comm_uart_packet_buffer == 0) {_sentry_comm_uart_packet_buffer = ('[data:newByteArray]' 32 0)}
  atPut 3 _sentry_comm_uart_packet_buffer address
  atPut 4 _sentry_comm_uart_packet_buffer 33
  atPut 5 _sentry_comm_uart_packet_buffer visionId
  atPut 6 _sentry_comm_uart_packet_buffer param_id
  atPut 7 _sentry_comm_uart_packet_buffer param_id
  local 'byteOffset' 0
  local 'paramByteOffset' 0
  for i 5 {
    byteOffset = (8 + ((i - 1) * 2))
    paramByteOffset = (1 + ((i - 1) * 2))
    atPut byteOffset _sentry_comm_uart_packet_buffer (at paramByteOffset paramsBuffer)
    atPut (byteOffset + 1) _sentry_comm_uart_packet_buffer (at (paramByteOffset + 1) paramsBuffer)
  }
  '_sentry comm uart send packet' 13
  local 'responseLength' ('_sentry comm uart read response')
  if (responseLength < 2) {
    return 2
  }
  if ((at 1 _sentry_comm_uart_response_buffer) == 224) {
    if (responseLength >= 2) {if ((at 2 _sentry_comm_uart_response_buffer) == 33) {
      return 0
    }}
  }
  return 1
}

