module udpLog
author 'AITosee'
version 1 2 
depends UDP WIFI 
description '基于udp协议日志调试库，服务器可以使用https://netlab.luatos.com/'
variables _LogCnt _UDPlogIp _UDPlogPort 

  spec ' ' 'UdpLogInit' 'UdpLog connect server _ port _' 'str str' '112.125.89.8' 32063
  spec ' ' 'UdpLog' 'UdpLog _ _ : _' 'str auto auto' ' tag' '' ''

to UdpLog tags val1 val2 {
  local 'var' ('[data:join]' ('[data:convertType]' tags 'string') ':' ('_anyTypeToString' val1))
  if ((pushArgCount) == 3) {
    var = ('[data:join]' var ' ' ('_anyTypeToString' val2))
  }
  _LogCnt += 1
  '[net:udpSendPacket]' ('[data:join]' ('[data:convertType]' _LogCnt 'string') ':' ('[data:convertType]' (millisOp) 'string') ':' ('[data:convertType]' ('[data:freeMemory]') 'string') ':' var) _UDPlogIp _UDPlogPort
}

to UdpLogInit bar baz {
  '[net:udpStart]' baz
  _UDPlogIp = bar
  _UDPlogPort = baz
}

to '_anyTypeToString' fooval {
  if (or (isType fooval 'list') (isType fooval 'byte array')) {
    local 'var' '[ '
    for i (size fooval) {
      var = ('[data:join]' var ('_anyTypeToString' (at i fooval)) ' ')
    }
    return ('[data:join]' var ']')
  } else {
    return ('[data:convertType]' fooval 'string')
  }
}

